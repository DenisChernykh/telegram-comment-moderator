{
  "name": "telegram-comment-moderator",
  "version": "0.1.0",
  "private": true,
  "description": "Single-owner Telegram comment moderation through ChatGPT MCP Events",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.15.1"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "wrangler dev --local",
    "check": "pnpm typegen:check && pnpm format:check && pnpm boundaries:check && pnpm typecheck && pnpm test && pnpm deploy:dry-run",
    "typegen": "wrangler types src/worker-configuration.d.ts --env-interface CloudflareBindings",
    "typegen:check": "wrangler types src/worker-configuration.d.ts --env-interface CloudflareBindings --check",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "boundaries:check": "node scripts/check-module-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:dry-run": "wrangler deploy --dry-run --env= && wrangler deploy --dry-run --env production",
    "deploy": "wrangler deploy --env production",
    "telegram:operator": "node scripts/telegram-operator.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "hono": "4.13.5",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@cloudflare/vitest-plugin": "1.1.2",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
